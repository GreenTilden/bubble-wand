# clawatch-bridge configuration template.
# install.sh writes a real clawatch.env from these values. Secrets
# (ANTHROPIC_API_KEY, CLAWATCH_TOKEN) are NOT set here — they are written by the
# /setup page after install, so no key is ever pasted into a file by hand.

# Bind address. 0.0.0.0 lets any device on your LAN reach the bridge.
CLAWATCH_HOST=0.0.0.0
# Port the bridge listens on.
CLAWATCH_PORT=8793
# The tmux window whose panes ARE your Claude Code threads (window "dev", win 1).
CLAWATCH_TMUX_WINDOW=dev:1
# install.sh points this back at the real clawatch.env so /setup can persist to it.
# CLAWATCH_ENV_FILE=/home/you/clawatch-bridge/clawatch.env

# --- Context pressure + the server-side wash (all optional) ---
# Pressure uses OPERATOR thresholds, not the vendor's context tier: the vendor
# only prints a tier near its own ~1M limit, so ordinary sessions carry none.
#CLAWATCH_CTX_SOFT_TOKENS=120000
#CLAWATCH_CTX_HARD_TOKENS=150000
#CLAWATCH_CTX_REARM_RATIO=0.8      # re-arm at 0.8x so a parked thread buzzes once
#CLAWATCH_CTX_SAMPLE_DELTA=5000    # log a context sample every 5k tokens moved...
#CLAWATCH_CTX_SAMPLE_INTERVAL=300  # ...or every 5 minutes, whichever comes first
#
# The event log records METRICS AND PANE IDENTITY ONLY, never pane content, and
# there is deliberately no HTTP route that serves it. 0600, rotated in place.
#CLAWATCH_EVENT_LOG=~/.local/state/bubble-wand/wash-events.jsonl
#
# A wash sends /clear to a pane and then optionally re-seeds it. The re-seed
# command is EMPTY by default on purpose: with none set, a wash stops after a
# verified clear and records that it did not re-seed. Set it to whatever
# slash-command restores your own working context.
#CLAWATCH_RESEED_COMMAND=
#CLAWATCH_RESEED_PROBE=            # repo-relative path; skip the re-seed if absent
#CLAWATCH_WASH_PANE_COMMANDS=claude  # allowlist — a pane at a shell is never washed
#CLAWATCH_AUTOWASH=0               # automatic wash on idle+hard pressure. Off.
